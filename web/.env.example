# --- storage (one of: AWS S3, Cloudflare R2, MinIO, Backblaze B2 …) ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# For Cloudflare R2 / non-AWS endpoints:
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_REGION=auto

# For AWS S3:
# STORAGE_REGION=ap-northeast-1

# Optional path prefix inside the bucket
# STORAGE_PREFIX=

# --- access control ---
# If unset, the viewer is PUBLIC. Set both to enable HTTP basic auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
