{
  "name": "cchist-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web viewer for cchist — Hono + JSX, deployable to Cloudflare Workers or Node (Railway)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch",
    "dev": "npm run build:css && tsx watch src/node.ts",
    "build": "npm run build:css",
    "start": "tsx src/node.ts",
    "dev:cf": "npm run build:css && wrangler dev",
    "deploy:cf": "npm run build:css && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=20"
  }
}
