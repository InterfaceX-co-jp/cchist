{
  "name": "cchist",
  "version": "0.1.0",
  "description": "Aggregate Claude Code conversation history from all your machines with one command",
  "type": "module",
  "bin": {
    "cchist": "./bin/cchist.mjs"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.mjs --format=esm",
    "dev": "bun run src/cli.ts",
    "start": "node dist/cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "conversation",
    "history",
    "archive",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InterfaceX-co-jp/cchist.git"
  }
}
